# Copy to .env (gitignored). Every line here is optional.
#
# Command Code subscription key — the same key that authenticates the CLI and
# the Provider API (create it at https://commandcode.ai/settings/keys).
# When present this transport wins: plain HTTP, ~1s, no subprocess.
CMD_API_KEY=

# Force a transport: commandcode-api | commandcode (CLI) | off
BIRDEYE_JEV_TRANSPORT=

# Absolute path to the CLI, if it is not on PATH and not under ~/.nvm.
BIRDEYE_CMD=
